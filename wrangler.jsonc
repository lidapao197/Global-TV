{
  "name": "global-tv",
  "main": "main.js",
  "compatibility_date": "2025-01-01",
  // 前端静态资源由 Cloudflare Static Assets 直接托管（CDN、自动 content-type、
  // 访问 / 自动返回 index.html）。binding 让请求先进 Worker，非 /api 路径
  // 再交给 env.ASSETS.fetch() 分发。
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS"
  }
}
